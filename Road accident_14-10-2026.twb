      <aliases enabled='yes' />
      <column caption='Accident Severity' datatype='string' name='[Accident_Severity]' role='dimension' type='nominal' />
      <column caption='PY Accidents' datatype='integer' name='[CY Accidents (copy)_2292258775650310]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT (IF  &#13;&#10;YEAR([Accident Date]) = [Parameters].[Current Year (copy)_2292258771824643]&#13;&#10;THEN &#13;&#10;[Index]&#13;&#10;END)' />
      </column>
      <column caption='PY Casulaties' datatype='integer' name='[CY Casulaties (copy)_2292258782953481]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if YEAR([Accident Date])=[Parameters].[Current Year (copy)_2292258771824643]&#13;&#10;THEN[Number_of_Casualties] END)' />
      </column>
      <column caption='PY Fatel Casualties' datatype='integer' name='[CY Fatel Casualties (copy)_2292258790105100]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Accident_Severity]=&apos;Fatal&apos;&#13;&#10;and YEAR([Accident Date])=[Parameters].[Current Year (copy)_2292258771824643]&#13;&#10;THEN [Number_of_Casualties] END)' />
      </column>
      <column caption='CY Serious Casualties' datatype='integer' name='[CY Fatel Casualties (copy)_2292258791079950]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Accident_Severity]=&apos;Serious&apos;&#13;&#10;and YEAR([Accident Date])=[Parameters].[Parameter 2292258771263490]&#13;&#10;THEN [Number_of_Casualties] END)' />
      </column>
      <column caption='CY Slight Casualties' datatype='integer' name='[CY Serious Casualties (copy)_2292258792570897]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Accident_Severity]=&apos;Slight&apos;&#13;&#10;and YEAR([Accident Date])=[Parameters].[Parameter 2292258771263490]&#13;&#10;THEN [Number_of_Casualties] END)' />
      </column>
      <column aggregation='Sum' caption='Year of accident Date' datatype='integer' name='[Calculation_2292258770395137]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='YEAR([Accident Date])' />
      </column>
      <column caption='CY Accidents' datatype='integer' name='[Calculation_2292258772230149]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT (IF  &#13;&#10;YEAR([Accident Date]) = [Parameters].[Parameter 2292258771263490]&#13;&#10;THEN &#13;&#10;[Index]&#13;&#10;END)' />
      </column>
      <column caption='YoY Accidents' datatype='real' default-format='* ▲0.00%; ▼0.00%' name='[Calculation_2292258776129543]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_2292258772230149]-[CY Accidents (copy)_2292258775650310])/([CY Accidents (copy)_2292258775650310])' />
      </column>
      <column caption='CY Casulaties' datatype='integer' name='[Calculation_2292258781433864]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if YEAR([Accident Date])=[Parameters].[Parameter 2292258771263490]&#13;&#10;THEN[Number_of_Casualties] END)' />
      </column>
      <column caption='CY Fatel Casualties' datatype='integer' name='[Calculation_2292258787889163]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Accident_Severity]=&apos;Fatal&apos;&#13;&#10;and YEAR([Accident Date])=[Parameters].[Parameter 2292258771263490]&#13;&#10;THEN [Number_of_Casualties] END)' />
      </column>
      <column caption='Accident Severity Filter' datatype='boolean' name='[Calculation_2292259016196117]' role='dimension' type='nominal'>
