            </column>
            <column caption='CY Casulaties' datatype='integer' name='[Calculation_2292258781433864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if YEAR([Accident Date])=[Parameters].[Parameter 2292258771263490]&#13;&#10;THEN[Number_of_Casualties] END)' />
            </column>
            <column caption='Accident Severity Filter' datatype='boolean' name='[Calculation_2292259016196117]' role='dimension' type='nominal'>
